{
  "name": "yentrans-website",
  "version": "2.0.0",
  "private": "true",
  "description": "Yentrans Maritime Logistics corporate website",
  "scripts": {
    "start": "eleventy --serve --port=8080",
    "build": "rm -rf _site && eleventy",
    "build:ghpages": "rm -rf _site && PATH_PREFIX=/yentrans-website/ eleventy",
    "check": "node tools/check-site.mjs",
    "clean": "rm -rf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0"
  },
  "type": "module",
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/manrope": "^5.1.0"
  }
}
