---
layout: layouts/base.njk
---
<article class="prose-page">
  <div class="wrap wrap-narrow">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="{{ '/careers/' | url }}">Careers</a> <span aria-hidden="true">/</span> <span>{{ title }}</span>
    </nav>
    <p class="eyebrow">{{ department }}</p>
    <h1>{{ title }}</h1>
    <dl class="job-facts">
      <div><dt>Location</dt><dd>{{ location }}</dd></div>
      {# Employment type is itself pending approval, so it is labelled rather than asserted. #}
      <div><dt>Employment type</dt><dd>{{ employmentType }}{% if not employmentTypeApproved %} <span class="pending">(proposed)</span>{% endif %}</dd></div>
      <div><dt>Experience</dt><dd>{{ experience }}</dd></div>
      {# Salary is internal editorial metadata. showSalary ships false and the
         content pack forbids displaying remuneration before management approval. #}
      {% if showSalary and salary %}<div><dt>Compensation</dt><dd>{{ salary }}</dd></div>{% endif %}
    </dl>
  </div>

  <div class="wrap wrap-narrow article-body">
    {{ content | safe }}
  </div>

  <div class="wrap wrap-narrow">
    {#- Three live routes, in order of preference. The secure form takes over the
        moment the Cloudflare intake is provisioned; until then an open role
        applies by email, which actually works. A role is never left advertised
        with no way to apply. -#}
    {% if status == "open" and approvals.forms.applicationEndpointEnabled.value %}
      <a class="btn btn-primary" href="{{ '/careers/apply/' | url }}?role={{ id }}">Apply for this role</a>
    {% elif status == "open" and applicationEmail %}
      {%- set subject = "Application: " + title + " (" + id + ")" %}
      {%- set body = "Please attach your CV as a PDF or DOCX before sending.%0D%0A%0D%0AName:%0D%0APhone:%0D%0ACurrent location:%0D%0AYears of experience:%0D%0ALinkedIn (optional):%0D%0A%0D%0ABriefly, why this role:%0D%0A" %}
      <a class="btn btn-primary"
         href="mailto:{{ applicationEmail }}?subject={{ subject | urlencode }}&amp;body={{ body }}">
        Apply by email <span class="arrow">&rarr;</span></a>
      <p class="apply-note">Send your CV as a PDF or DOCX to
        <a href="mailto:{{ applicationEmail }}">{{ applicationEmail }}</a>, quoting
        <strong>{{ title }}</strong>. Please don't attach identity documents at this stage.
        A submission doesn't guarantee an interview; we reply if your experience matches
        what the role needs.</p>
    {% elif status == "open" %}
      <div class="notice">
        <strong>Applications are not open yet.</strong>
        No application channel has been enabled for this role, so we cannot accept or
        store a submission. Please check back rather than sending documents by another route.
      </div>
    {% else %}
      <div class="notice">
        <strong>This vacancy is an internal draft.</strong>
        It has not been approved for publication and is not open for applications.
        No application channel is available for it.
      </div>
    {% endif %}
  </div>
</article>
{# No JobPosting schema for a draft or unapproved role — an explicit brief requirement. #}
{% if status == "open" and publishedAt %}
{# Mind the space in "} }" where the nested address object closes. Two closing
   braces together terminate this {{ }} output expression early, truncating the
   object and failing the build with "parseAggregate: expected comma after
   expression". A Nunjucks comment cannot sit inside the expression either —
   that produces "unexpected token: #" — which is why this note is out here. #}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org", "@type": "JobPosting",
  "title": title,
  "description": excerpt,
  "datePosted": publishedAt,
  "validThrough": applicationDeadline,
  "employmentType": employmentTypeSchema,
  "hiringOrganization": {
    "@type": "Organization", "name": site.name, "url": site.productionUrl
  },
  "jobLocation": { "@type": "Place", "address": {
    "@type": "PostalAddress",
    "addressLocality": addressLocality,
    "addressRegion": addressRegion,
    "addressCountry": addressCountry
  } },
  "directApply": false
} | jsonld | safe }}</script>
{% endif %}
