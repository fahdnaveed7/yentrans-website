{# Icon system.

   Drawn here rather than pulled from a library so the whole set shares one
   geometry: 24×24 box, 1.5 stroke, round caps, no fills. The brand package
   lists no icon set, and a mixed bag of library icons at different optical
   weights is a large part of why a page looks assembled rather than designed.

   Usage:  {% from "partials/icon.njk" import icon %}  {{ icon("container") }}
#}
{% macro icon(name, cls="") %}
<svg class="ico {{ cls }}" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
     aria-hidden="true" focusable="false">
{%- if name == "container" -%}
  <rect x="2" y="7" width="20" height="11" rx="1"/><path d="M6 7v11M10 7v11M14 7v11M18 7v11"/><path d="M2 5h20"/>
{%- elif name == "boxes" -%}
  <rect x="3" y="12" width="8" height="7" rx="1"/><rect x="13" y="12" width="8" height="7" rx="1"/><rect x="8" y="4" width="8" height="7" rx="1"/>
{%- elif name == "reefer" -%}
  <path d="M12 2v20M12 6 8.5 3.5M12 6l3.5-2.5M12 18l-3.5 2.5M12 18l3.5 2.5"/>
  <path d="m3.5 7 17 10M3.5 7l.4 4.2M3.5 7l4-1.3M20.5 17l-.4-4.2M20.5 17l-4 1.3"/>
  <path d="m20.5 7-17 10M20.5 7l-4-1.3M20.5 7l-.4 4.2M3.5 17l4 1.3M3.5 17l.4-4.2"/>
{%- elif name == "document" -%}
  <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"/><path d="M14 2v5h5"/><path d="M9 13h6M9 17h4"/>
{%- elif name == "truck" -%}
  <path d="M2 6h11v10H2z"/><path d="M13 9h4l3 3.5V16h-7z"/><circle cx="6" cy="18.5" r="2"/><circle cx="17" cy="18.5" r="2"/>
{%- elif name == "crane" -%}
  <path d="M4 21V4h2l12 3"/><path d="M6 4h14"/><path d="M14 7v4"/><rect x="11" y="11" width="6" height="5" rx="1"/><path d="M2 21h20"/>
{%- elif name == "shield" -%}
  <path d="M12 2 4 5.5v6c0 4.6 3.4 8 8 9.5 4.6-1.5 8-4.9 8-9.5v-6z"/><path d="m9 12 2 2 4-4"/>
{%- elif name == "ship" -%}
  <path d="M2 18.5c1.6 0 1.6 1.2 3.2 1.2s1.6-1.2 3.2-1.2 1.6 1.2 3.2 1.2 1.6-1.2 3.2-1.2 1.6 1.2 3.2 1.2 1.6-1.2 3.2-1.2"/>
  <path d="M4 16 5.5 9h13L20 16"/><path d="M12 9V4H8"/>
{%- elif name == "globe" -%}
  <circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18"/>
{%- elif name == "route" -%}
  <circle cx="5" cy="6" r="2.4"/><circle cx="19" cy="18" r="2.4"/><path d="M7.4 6h6.1a3.5 3.5 0 0 1 0 7H10a3.5 3.5 0 0 0 0 7h6.6"/>
{%- elif name == "clock" -%}
  <circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>
{%- elif name == "people" -%}
  <path d="M16 20v-1.5a3.5 3.5 0 0 0-3.5-3.5h-5A3.5 3.5 0 0 0 4 18.5V20"/><circle cx="10" cy="8" r="3.5"/>
  <path d="M20 20v-1.5a3.5 3.5 0 0 0-2.6-3.4"/><path d="M15.5 4.6a3.5 3.5 0 0 1 0 6.8"/>
{%- elif name == "arrow" -%}
  <path d="M5 12h14M13 6l6 6-6 6"/>
{%- endif -%}
</svg>
{% endmacro %}
