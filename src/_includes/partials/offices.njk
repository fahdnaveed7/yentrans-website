{# Office cards, grouped by region.

   Deliberately minimal: location, role and one contact route. Street addresses,
   named branch managers and their personal mobiles all remain in offices.json
   but are gated off — approvals.officeStreetAddresses and
   approvals.staffContactDetails — so restoring any of it is a flag flip rather
   than re-entering data.

   Every card routes to the central desk while approvals.roleMailboxes is false.
   Per-region addresses render automatically once each office's `email` is set
   to a mailbox that has been confirmed to receive mail. #}
{%- for group in offices.groups %}
<div class="office-group">
  <div class="office-region-head">
    <h3 class="office-region">{{ group.title }}</h3>
    {#- One contact route per region rather than the same address repeated on
        every card. Once approvals.roleMailboxes is true and each office has its
        own confirmed mailbox, this moves back onto the cards. -#}
    {%- set regionEmail = site.enquiryEmail %}
    {%- for id in group.ids %}{% for o in offices.locations %}{% if o.id == id and o.approved and o.email != site.enquiryEmail %}{% set regionEmail = o.email %}{% endif %}{% endfor %}{% endfor %}
    <p class="office-region-contact"><a href="mailto:{{ regionEmail }}">{{ regionEmail }}</a></p>
  </div>
  <div class="offices">
    {%- for id in group.ids %}{% for o in offices.locations %}{% if o.id == id %}
    <div class="office reveal" id="office-{{ o.id }}">
      <span class="tag">{{ o.role }}</span>
      <h4>{{ o.city }}{% if o.cityFull %} <span class="city-full">({{ o.cityFull }})</span>{% endif %}</h4>
      {#- Country only when it adds something the region heading has not already
          said: redundant under "India", informative under "Middle East" where
          the three offices span two countries. -#}
      {% if o.country != group.title %}<p class="office-place">{{ o.country }}</p>{% endif %}

      {%- if o.approved %}
        {% if approvals.officeStreetAddresses.value and o.address %}
        <address>{% for line in o.address %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</address>
        {% endif %}
        {%- if approvals.staffContactDetails.value %}
          {% if o.contactName %}<p class="office-contact">{{ o.contactName }}</p>{% endif %}
          {% if o.phone %}<p class="ph"><a href="tel:{{ o.phoneDial }}">{{ o.phone }}</a></p>{% endif %}
        {%- endif %}
        {% if o.email != site.enquiryEmail %}<p class="ph"><a href="mailto:{{ o.email }}">{{ o.email }}</a></p>{% endif %}
      {%- else %}
        <p class="office-coverage">{{ o.coverage }}</p>
      {%- endif %}
    </div>
    {% endif %}{% endfor %}{%- endfor %}
  </div>
</div>
{%- endfor %}
