{# Utility strip. Thin navy bar carrying the direct contact routes, so a visitor
   never has to hunt for a phone number. The founding year is gated (YML-001)
   and disappears with the flag. #}
<div class="util-bar">
  <div class="wrap util-in">
    <p class="util-claim">Freight forwarding, customs and inland transport{% if approvals.corporate.established2009.value %} &middot; Kochi since 2009{% endif %}</p>
    <div class="util-links">
      <a href="tel:{{ site.enquiryPhoneDial }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        {{ site.enquiryPhone }}</a>
      <a href="mailto:{{ site.enquiryEmail }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z"/><path d="m22 6-10 7L2 6"/></svg>
        {{ site.enquiryEmail }}</a>
    </div>
  </div>
</div>

<header class="site-head">
  <div class="wrap head-in">
    <a class="brand" href="{{ '/' | url }}" aria-label="{{ site.name }}, home">
      {# Brand package has no cleared logo: YML_Registered_Logo_PROVISIONAL.png carries an
         uncleared registered symbol (YML-009) and is marked approved_for_public_website=false.
         The existing artwork stays until a vector master without the symbol is supplied. #}
      <img src="{{ '/assets/img/logo.png' | url }}" alt="{{ site.name }}" width="406" height="105">
    </a>

    <nav class="nav-main" aria-label="Primary">
      {%- for item in nav.primary %}
      <a href="{{ item.url | url }}"{% if page.url == item.url or (item.url != '/' and page.url.startsWith(item.url)) %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- endfor %}
    </nav>

    <div class="head-actions">
      <a class="btn btn-primary head-cta" href="{{ nav.cta.url | url }}">{{ nav.cta.label }}</a>
      <button class="menu-btn" id="menu-btn" aria-expanded="false" aria-controls="mega" aria-haspopup="true">
        <span class="menu-btn-label">Menu</span>
        <span class="menu-bars" aria-hidden="true"><span></span><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

{# Mega panel, built from the same data that renders the pages, so a new service
   or industry appears here without anyone editing this template. #}
<div class="mega" id="mega" hidden>
  <div class="wrap mega-in">
    <div class="mega-col">
      <p class="mega-h"><a href="{{ '/services/' | url }}">Services</a></p>
      <ul>
        {%- for s in services.items %}
        <li><a href="{{ ('/services/' + s.slug + '/') | url }}">{{ s.title }}</a></li>
        {%- endfor %}
      </ul>
    </div>

    <div class="mega-col mega-col--wide">
      <p class="mega-h"><a href="{{ '/industries/' | url }}">Industries</a></p>
      <div class="mega-groups">
        {%- for g in industries.groups %}
        <div>
          <p class="mega-group-h">{{ g.title }}</p>
          <ul>
            {%- for i in industries.items %}{% if i.group == g.id %}
            <li><a href="{% if i.flagship %}{{ ('/industries/' + i.slug + '/') | url }}{% else %}{{ '/industries/' | url }}#{{ i.slug }}{% endif %}">{{ i.title }}</a></li>
            {%- endif %}{% endfor %}
          </ul>
        </div>
        {%- endfor %}
      </div>
    </div>

    <div class="mega-col">
      <p class="mega-h"><a href="{{ '/about/' | url }}">Company</a></p>
      <ul>
        <li><a href="{{ '/about/' | url }}">About Yentrans</a></li>
        <li><a href="{{ '/network/' | url }}">Global network</a></li>
        <li><a href="{{ '/careers/' | url }}">Careers</a></li>
        <li><a href="{{ '/contact/' | url }}">Contact</a></li>
      </ul>
      <p class="mega-h mega-h--spaced"><a href="{{ '/insights/' | url }}">Resources</a></p>
      <ul>
        <li><a href="{{ '/insights/' | url }}">Insights &amp; news</a></li>
        <li><a href="{{ '/resources/' | url }}">Knowledge hub</a></li>
      </ul>
      <a class="btn btn-primary mega-cta" href="{{ nav.cta.url | url }}">{{ nav.cta.label }}</a>
    </div>
  </div>
</div>
